OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Per-role models (blank = use LLM_MODEL)
LLM_MODEL_ATTACKER=qwen/qwen3.8-27b
LLM_MODEL_JUDGE=openai/gpt-oss-120b
LLM_MODEL_TARGET=openai/gpt-oss-120b
# Qwen thinking depth: none | low | medium | high (blank = model default)
LLM_REASONING_EFFORT_ATTACKER=none
# Comma-separated models to try when the primary fails
LLM_FALLBACKS=openai/gpt-oss-120b

# Qwen instruct-mode sampling (from the model page); leave a line out to use the provider default
LLM_TEMPERATURE_ATTACKER=0.7
